<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/belucha/oxyplot.blazor</PackageProjectUrl>
		<RepositoryUrl>https://github.com/belucha/oxyplot.blazor</RepositoryUrl>
		<Description>Blazor Binding for OxyPlot</Description>
		<PackageId>OxyPlot.Blazor</PackageId>
		<IsPackable>true</IsPackable>
		<PackageTags>Chart,Web,Blazor,Oxyplot</PackageTags>
		<PackageReadmeFile>README.MD</PackageReadmeFile>
		<Version></Version>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<!-- Reference only the Blazor packages instead of the Microsoft.AspNetCore.App shared framework,
	     so the library can be used from Blazor WebAssembly apps (browser-wasm has no AspNetCore.App runtime pack). -->
	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="..\README.MD">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\demo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="OxyPlot.Core" Version="2.2.*" />
	</ItemGroup>
</Project>